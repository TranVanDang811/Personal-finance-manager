# =====================================================================
# DangCap (Personal Finance Manager) — Docker / Production Environment
# Copy this file to .env before running `docker compose up -d --build`
# =====================================================================

# --- Server & Profile ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Database (MySQL 8.4) ---
MYSQL_DATABASE=pfm_db
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
DB_USERNAME=pfm_user
DB_PASSWORD=change_me_strong_db_password
MYSQL_HOST_PORT=127.0.0.1:3307

# --- Database SSL (Bật true và false khi kết nối Cloud DB từ xa) ---
DB_USE_SSL=true
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# --- Cache & Sessions (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password

# --- Security & JWT (HMAC-SHA256 >= 32 chars; e.g. `openssl rand -base64 48`) ---
JWT_SECRET=replace_with_a_randomly_generated_256_bit_secret_key_for_production
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
PASSWORD_RESET_EXPIRATION_MS=900000

# --- CORS & Reverse Proxy ---
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com
FRONTEND_PORT=80
HTTPS_PORT=443
FRONTEND_RESET_URL=http://localhost/reset-password

# --- Auth Rate Limiting (Brute-Force Protection) ---
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_TRUST_FORWARDED=true

# --- Media Storage ("local" or "cloudinary") ---
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=pfm

# --- SMTP Email Service (Gmail / SMTP Relay) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DangCap <noreply@dangcap.local>
