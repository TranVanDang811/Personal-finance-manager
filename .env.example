# =====================================================================
# DangCap (Personal Finance Manager) — Docker / Production Environment
# Copy to .env before running `docker compose up -d --build`
# =====================================================================

# --- Database (MySQL 8) ---
MYSQL_DATABASE=pfm_db
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
DB_USERNAME=pfm_user
DB_PASSWORD=change_me_strong_db_password

# --- Cache & Session Security (Redis 7) ---
REDIS_PASSWORD=change_me_strong_redis_password

# --- JWT Security (MUST be >= 32 characters; e.g. `openssl rand -base64 48`) ---
JWT_SECRET=replace_with_a_randomly_generated_256_bit_secret_key_for_production
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
PASSWORD_RESET_EXPIRATION_MS=900000

# --- CORS & Reverse Proxy ---
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com
FRONTEND_PORT=80

# --- Auth Rate Limiting ---
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Media Storage ("local" or "cloudinary") ---
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=pfm

